{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:porchday:archive:v1",
  "title": "Porchday portable archive manifest, version 1",
  "description": "The archive.json inside a locally decrypted ZIP part. This is not a server envelope, proof of authorship, or a key backup. Container, cross-part, ownership, checksum and expiry checks are also required; see README.md.",
  "type": "object",
  "required": ["format", "version", "generated_at", "member_id", "handle", "profile", "posts", "comments", "reactions", "media", "connections", "groups"],
  "properties": {
    "format": { "const": "porchday-archive" },
    "version": { "const": 1 },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "member_id": { "$ref": "#/$defs/id" },
    "handle": { "type": "string" },
    "archive_set": { "$ref": "#/$defs/archiveSet" },
    "profile": { "anyOf": [{ "$ref": "#/$defs/profile" }, { "type": "null" }] },
    "posts": { "type": "array", "items": { "$ref": "#/$defs/authoredEntry" } },
    "comments": { "type": "array", "items": { "$ref": "#/$defs/authoredEntry" } },
    "reactions": { "type": "array", "items": { "$ref": "#/$defs/authoredEntry" } },
    "media": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/groupMembership" } }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "deadline": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "archiveSet": {
      "type": "object",
      "required": ["id", "index", "total"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 1 },
        "total": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "complete": { "type": "boolean" }
      },
      "allOf": [{
        "if": { "required": ["complete"], "properties": { "complete": { "const": true } } },
        "then": { "properties": { "total": { "type": "integer", "minimum": 1 } } },
        "else": { "properties": { "total": { "type": "null" } } }
      }],
      "additionalProperties": true
    },
    "audience": { "enum": ["connections", "family", "only_me", "group", "moderators"] },
    "photoReference": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "alt": { "type": "string" },
        "mime": { "const": "image/jpeg" },
        "name": { "type": "string" },
        "width": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2400 }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "description": "Decrypted profile payload; theme, section order and future profile fields are retained. It is not wrapped in an authoredEntry.",
      "properties": {
        "avatar": { "anyOf": [{ "$ref": "#/$defs/photoReference" }, { "type": "null" }] },
        "cover": { "anyOf": [{ "$ref": "#/$defs/photoReference" }, { "type": "null" }] },
        "background": { "anyOf": [{ "$ref": "#/$defs/photoReference" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 5000 },
        "media": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/photoReference" } },
        "emoji": { "type": "string", "description": "Reaction catalog identifier, such as like; not a separate reaction count." },
        "reactionSecret": { "type": "string", "description": "Optional content-local reaction-tag seed. Never an account recovery key. Destination clients generate a fresh seed." },
        "provenance": { "anyOf": [{ "type": "object" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "authoredEntry": {
      "type": "object",
      "required": ["id", "created_at", "expires_at", "audience", "parent_id", "group_id", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/deadline" },
        "audience": { "$ref": "#/$defs/audience" },
        "parent_id": { "$ref": "#/$defs/nullableId" },
        "group_id": { "$ref": "#/$defs/nullableId" },
        "payload": { "$ref": "#/$defs/payload" }
      },
      "additionalProperties": true
    },
    "photo": {
      "type": "object",
      "required": ["id", "path", "mime", "alt", "width", "height", "sha256", "post_id", "profile_id", "group_id", "slot", "created_at", "expires_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^photos/[a-fA-F0-9-]{36}\\.jpg$" },
        "mime": { "const": "image/jpeg" },
        "alt": { "type": "string" },
        "name": { "type": "string", "description": "Optional; currently emitted by web, not native iOS." },
        "width": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "post_id": { "$ref": "#/$defs/nullableId" },
        "profile_id": { "$ref": "#/$defs/nullableId" },
        "group_id": { "$ref": "#/$defs/nullableId" },
        "slot": { "enum": ["avatar", "cover", "background", "image", null] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/deadline" }
      },
      "additionalProperties": true
    },
    "connection": {
      "type": "object",
      "required": ["member_id", "kind"],
      "properties": { "member_id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["friend", "family"] } },
      "additionalProperties": true
    },
    "groupMembership": {
      "type": "object",
      "required": ["group_id", "role"],
      "properties": { "group_id": { "$ref": "#/$defs/id" }, "role": { "enum": ["owner", "moderator", "member"] } },
      "additionalProperties": true
    }
  }
}
