{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"porchday-monitor-local",
  "main":"src/index.ts",
  "compatibility_date":"2026-10-24",
  "workers_dev":false,
  "preview_urls":false,
  "durable_objects":{"bindings":[{"name":"STATE","class_name":"Monitor"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Monitor"]}],
  "vars":{"ENVIRONMENT":"staging","EMAIL_FROM":"Porchday <accounts@porchday.com>"},
  "observability":{"enabled":true,"logs":{"enabled":true,"invocation_logs":false},"traces":{"enabled":false}}
}
